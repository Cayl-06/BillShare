<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_white"
    android:padding="16dp">

    <!-- Avatar Initial -->
    <TextView
        android:id="@+id/tvSplitMemberInitial"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circle_icon"
        android:gravity="center"
        android:text="A"
        android:textColor="#539CFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Name + Amount -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="52dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSplitMemberName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alex Doe"
            android:textColor="#1E293B"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSplitMemberAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="$40.00"
            android:textColor="#64748B"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Paid / Mark Paid button -->
    <TextView
        android:id="@+id/btnMarkPaid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="Mark Paid"
        android:textColor="#539CFF"
        android:textSize="12sp"
        android:textStyle="bold" />

</RelativeLayout>